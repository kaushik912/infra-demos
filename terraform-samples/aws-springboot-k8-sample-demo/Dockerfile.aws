# Replacement for the repo's Dockerfile, which uses gradle:8.7 (Boot 4.1 needs the
# wrapper's Gradle 9.x) and a glob in exec-form ENTRYPOINT (never expanded).
# Build from the project root: docker build -f Dockerfile.aws -t springboot-k8-sample:local .
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN chmod +x gradlew && ./gradlew bootJar -x test --no-daemon

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/build/libs/springboot-k8-sample-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
